# ==============================================================================
# Tireless Hand Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: 100% Free Local Inference via Ollama (Default - No API Keys Needed!)
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_FAST=qwen2.5-coder:1.5b
OLLAMA_MODEL_SMART=qwen2.5-coder:7b
OLLAMA_MODEL_VISION=llava:latest

# ------------------------------------------------------------------------------
# OPTION 2: Cloud API Keys (If you don't have Ollama installed)
# Just uncomment your preferred provider and add your API key!
# ------------------------------------------------------------------------------

# --- OpenAI (or compatible: Groq, OpenRouter, DeepSeek, Together, LMStudio) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-your-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Groq (Ultra-fast cloud inference) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=gsk_your_groq_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (Access 100+ models) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=qwen/qwen-2.5-coder-32b-instruct

# --- Google Gemini ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Browser & Test Engine Settings
# ------------------------------------------------------------------------------
HEADLESS=false
SLOW_MO=100
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# ------------------------------------------------------------------------------
# Persistent Memory & Baselines
# ------------------------------------------------------------------------------
MEMORY_DB_PATH=./memory/app_graph.db
BASELINE_DIR=./memory/baselines
