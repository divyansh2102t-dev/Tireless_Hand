# Tireless Hand Configuration
# No API keys needed! Uses local Ollama models.

# Ollama server URL (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Models (must be pulled in Ollama first)
OLLAMA_MODEL_FAST=qwen2.5-coder:1.5b
OLLAMA_MODEL_SMART=qwen2.5-coder:7b
OLLAMA_MODEL_VISION=llava:latest

# Browser settings
HEADLESS=false
SLOW_MO=100
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Memory
MEMORY_DB_PATH=./memory/app_graph.db
BASELINE_DIR=./memory/baselines
